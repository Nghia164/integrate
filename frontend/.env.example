# Smart Scheduling - Môi trường mẫu (.env.example)
# Sao chép file này thành .env hoặc .env.local để cấu hình môi trường phát triển cục bộ

# Địa chỉ API backend (Laravel / Node.js)
VITE_API_URL=http://localhost:8000/api

# Cấu hình toạ độ cửa hàng phục vụ chấm công GPS (Mặc định: TP. Hồ Chí Minh)
VITE_STORE_LATITUDE=10.7769
VITE_STORE_LONGITUDE=106.7009
VITE_STORE_RADIUS_METERS=200
VITE_CHECK_IN_WINDOW_MINUTES=15
